# Copia este archivo como .env para desarrollo local. Nunca subas un archivo .env real.
# En producción usa variables configuradas directamente en la plataforma de despliegue.
NODE_ENV=development
# URL pública del proyecto. En producción debe comenzar por https://
APP_ORIGIN=http://localhost:3000
PORT=3000

# Desarrollo local con PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=Acme Bank
PGUSER=postgres
PGPASSWORD=

# Producción: usa la cadena de conexión entregada por el proveedor PostgreSQL.
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/base?sslmode=verify-full
DATABASE_URL=
DATABASE_SSL=true
# Mantén true salvo que el proveedor documente expresamente otra configuración.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Secreto de sesión: mínimo 32 caracteres aleatorios, único para cada entorno.
JWT_SECRET=

# Opcional: rutas locales a herramientas de respaldo si no están disponibles en PATH.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
